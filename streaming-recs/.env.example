# Copy to .env.local and fill in.

# TMDb API credential (free). Get one at https://www.themoviedb.org/settings/api
# Preferred: the v4 "API Read Access Token" (a long JWT). Paste it here:
TMDB_ACCESS_TOKEN=

# Alternatively, the older v3 "API Key". Used only if TMDB_ACCESS_TOKEN is empty.
TMDB_API_KEY=

# Region used for streaming-availability lookups (ISO 3166-1). Default: US
TMDB_REGION=US
